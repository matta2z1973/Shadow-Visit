# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Supabase → Database → Connection string, "URI")
DATABASE_URL=postgres://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Email (Resend) — used for magic links via Supabase SMTP and for .ics invites
RESEND_API_KEY=re_xxx
EMAIL_FROM=admissions@greenhill.org

# App base URL (used in email links + auth redirect)
APP_URL=http://localhost:3000
